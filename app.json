{
  "expo": {
    "name": "중고마켓",
    "slug": "junggo-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF9F4",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.junggomarket",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "상품 사진을 등록하기 위해 사진 보관함에 접근합니다."
      }
    },
    "android": {
      "package": "com.example.junggomarket"
    },
    "plugins": [
      [
        "expo-image-picker",
        { "photosPermission": "상품 사진을 등록하기 위해 사진 보관함에 접근합니다." }
      ]
    ]
  }
}
